# Production (required)
DATABASE_URL=
SETUP_ACCESS_CODE=
SESSION_SECRET=
# Exactly 32 bytes: 64 hex characters, or base64 decoding to 32 bytes.
# Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional
GHL_API_BASE_URL=https://services.leadconnectorhq.com
GHL_API_VERSION=v3
# Pre-setup fallbacks for the public form and booking pages.
GHL_FORM_URL=
GHL_BOOKING_URL=

# Only read by `npm run verify:ghl`, not by the app.
# The app gets its token through the /setup wizard instead.
GHL_TOKEN=
GHL_LOCATION_ID=
